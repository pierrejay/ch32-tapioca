#!/usr/bin/env python3
"""mdioctl - phytool-style CLI for the Tapioca MDIO master firmware.

Speaks the device's ASCII wire protocol (!read / !write / !print) over its
USB-CDC port and presents a phytool-compatible interface: same verbs, same
output - minus the interface field (there's only one USB port, not a NIC).

    mdioctl read  <phy>/<reg>           # print the 16-bit value, e.g. 0x1140
    mdioctl read  <phy>:<mmd>/<reg>     # read an MMD / Clause-45-style register
    mdioctl write <phy>/<reg> <val>     # silent on success (like phytool)
    mdioctl write --verify <path> <val> # silent if write + exact readback succeed
    mdioctl print <phy>                 # pretty-dump the IEEE 802.3 registers
    mdioctl print --mmd <mmd> <phy>     # dump an MMD register window

Numbers are base-0: 0x.. hex or plain decimal. The CDC port is resolved as
--port, else $MDIO_PORT, else auto-detected when a single device is present.

Writes also stay silent on success. With --verify, the CLI first waits for the
device-side write OK, then reads the same register back and compares the exact
value; only failures print to stderr. Errors (no PHY -> "noresp", stalled blob ->
"timeout", verify mismatch) exit non-zero, so it pipes/scripts like phytool does.
Stdlib only (termios/os/select);
the CDC port ignores the baud rate. See README.md - the wire grammar is plain
ASCII, so any terminal can drive the bus by hand; mdioctl is just the wrapper.
"""
import argparse
import glob
import os
import re
import select
import sys
import termios
import time


# ---- CDC port plumbing -------------------------------------------------------
def list_ports():
    return sorted(glob.glob("/dev/cu.usbmodem*") +
                  glob.glob("/dev/tty.usbmodem*") +
                  glob.glob("/dev/ttyACM*"))


def open_port(path):
    fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    a = termios.tcgetattr(fd)
    a[0] = a[1] = a[3] = 0                        # iflag, oflag, lflag: raw
    a[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
    try:
        a[4] = a[5] = termios.B115200             # ispeed/ospeed (CDC ignores it)
    except AttributeError:
        pass
    a[6][termios.VMIN] = 0
    a[6][termios.VTIME] = 0
    termios.tcsetattr(fd, termios.TCSANOW, a)
    return fd


def pick_port(explicit):
    if explicit:                                  # --port wins over $MDIO_PORT and auto
        return explicit
    env = os.environ.get("MDIO_PORT")
    if env:
        return env
    ports = list_ports()
    if not ports:
        sys.exit("mdioctl: no /dev/cu.usbmodem* found - plug the master in")
    if len(ports) > 1:
        sys.exit("mdioctl: several ports, pass one with --port:\n  " + "\n  ".join(ports))
    return ports[0]


def flush_input(fd):
    """Discard any pending bytes (e.g. the boot banner) before the first command."""
    while select.select([fd], [], [], 0)[0]:
        if not os.read(fd, 4096):
            break


def converse(fd, line, want=1, idle=0.12, maxwait=2.0):
    """Send one command line; collect response lines until `want` of them arrive
    or the device goes quiet for `idle`. '#' banner lines are dropped."""
    os.write(fd, (line + "\n").encode())
    start = time.time()
    buf, lines = b"", []
    while time.time() - start < maxwait:
        if select.select([fd], [], [], idle)[0]:
            chunk = os.read(fd, 4096)
            if not chunk:
                continue
            buf += chunk
            while b"\n" in buf:
                raw, buf = buf.split(b"\n", 1)
                s = raw.decode("latin1", "ignore").strip()
                if s and not s.startswith("#"):
                    lines.append(s)
            if len(lines) >= want:
                break
        elif lines:
            break                                 # idle gap after we got something
    return lines


# ---- wire response parsing ---------------------------------------------------
PATH_RE = r"(\d+)(?::(\d+))?/((?:0x)?[0-9A-Fa-f]+)"
RE_OK  = re.compile(r"^(read|write)\s+" + PATH_RE + r"\s+(?:0x([0-9A-Fa-f]+)|ok)$")
RE_ERR = re.compile(r"^(read|write)\s+" + PATH_RE + r"\s+err\s+(\S+)$")


def path_text(phy, mmd, reg):
    return "%d:%d/0x%04x" % (phy, mmd, reg) if mmd is not None else "%d/%d" % (phy, reg)


def resp_matches(m, verb, phy, mmd, reg):
    if not m or m.group(1) != verb:
        return False
    rmmd = int(m.group(3)) if m.group(3) is not None else None
    return int(m.group(2)) == phy and rmmd == mmd and int(m.group(4), 0) == reg


def parse_resp(lines, verb, phy, mmd, reg):
    """Find this transaction's reply among `lines`. Returns (value|None, err|None)."""
    for s in lines:
        m = RE_ERR.match(s)
        if resp_matches(m, verb, phy, mmd, reg):
            return None, m.group(5)
        m = RE_OK.match(s)
        if resp_matches(m, verb, phy, mmd, reg):
            return (int(m.group(5), 16) if m.group(5) is not None else 0), None
    return None, "no-response-from-device"


def num(s, lo, hi, what):
    try:
        v = int(s, 0)
    except ValueError:
        sys.exit("mdioctl: %s '%s' is not a number" % (what, s))
    if not (lo <= v <= hi):
        sys.exit("mdioctl: %s %d out of range [%d..%d]" % (what, v, lo, hi))
    return v


def split_path(path, want_reg):
    """phy/reg, phy:mmd/reg (want_reg), or just phy. Returns (phy, mmd-or-None, reg-or-None)."""
    parts = path.split("/")
    if want_reg:
        if len(parts) != 2:
            sys.exit("mdioctl: expected <phy>/<reg> or <phy>:<mmd>/<reg>, got '%s'" % path)
        head = parts[0].split(":")
        if len(head) == 1:
            return num(head[0], 0, 31, "phy"), None, num(parts[1], 0, 31, "reg")
        if len(head) == 2:
            return (num(head[0], 0, 31, "phy"),
                    num(head[1], 0, 31, "mmd"),
                    num(parts[1], 0, 0xFFFF, "reg"))
        sys.exit("mdioctl: expected <phy>/<reg> or <phy>:<mmd>/<reg>, got '%s'" % path)
    if len(parts) != 1:
        sys.exit("mdioctl: expected <phy>, got '%s'" % path)
    if ":" in parts[0]:
        sys.exit("mdioctl: expected <phy>, got '%s'" % path)
    return num(parts[0], 0, 31, "phy"), None, None


# ---- IEEE 802.3 Clause-22 register pretty-print ------------------------------
# Naming/decoding lives host-side (the device only returns raw values). We decode
# the standardised registers 0..6 like phytool; vendor regs 7..31 stay raw.
STD = {0: "BMCR", 1: "BMSR", 2: "PHYID1", 3: "PHYID2",
       4: "ANAR", 5: "ANLPAR", 6: "ANER"}


def dec_bmcr(v):
    speed = {0b00: "10", 0b01: "100", 0b10: "1000"}.get(
        (((v >> 6) & 1) << 1) | ((v >> 13) & 1), "?")
    out = ["speed=%s" % speed,
           "duplex=full" if v & (1 << 8) else "duplex=half",
           "autoneg=on" if v & (1 << 12) else "autoneg=off"]
    for bit, name in ((15, "reset"), (14, "loopback"), (11, "powerdown"),
                      (10, "isolate"), (9, "restart-an")):
        if v & (1 << bit):
            out.append(name)
    return " ".join(out)


def dec_bmsr(v):
    out = ["link=up" if v & (1 << 2) else "link=down",
           "autoneg=" + ("complete" if v & (1 << 5) else "incomplete")]
    if v & (1 << 4):
        out.append("remote-fault")
    if v & (1 << 1):
        out.append("jabber")
    caps = [n for bit, n in ((11, "10H"), (12, "10F"), (13, "100H"),
                             (14, "100F"), (15, "100T4")) if v & (1 << bit)]
    s = " ".join(out)
    return s + ("  caps: " + " ".join(caps) if caps else "")


def dec_aneg(v):                                  # ANAR / ANLPAR share the layout
    adv = [n for bit, n in ((5, "10H"), (6, "10F"), (7, "100H"), (8, "100F"),
                            (9, "100T4"), (10, "pause"), (11, "asym-pause"))
           if v & (1 << bit)]
    s = "adv: " + (" ".join(adv) if adv else "none")
    if v & (1 << 13):
        s += " remote-fault"
    if v & (1 << 15):
        s += " next-page"
    return s


def do_print(fd, phy):
    """!print <phy> -> 32 raw reads on the device; pretty-dump them host-side."""
    lines = converse(fd, "!print %d" % phy, want=32, idle=0.15, maxwait=4.0)
    vals, errs = {}, {}
    for s in lines:
        m = RE_OK.match(s)
        if m and m.group(1) == "read" and int(m.group(2)) == phy and m.group(3) is None and m.group(5) is not None:
            vals[int(m.group(4), 0)] = int(m.group(5), 16)
            continue
        m = RE_ERR.match(s)
        if m and m.group(1) == "read" and int(m.group(2)) == phy and m.group(3) is None:
            errs[int(m.group(4), 0)] = m.group(5)

    if not vals and not errs:
        sys.exit("mdioctl: no response from device (wrong port, or firmware not in MDIO mode?)")

    print("PHY %d - IEEE 802.3 Clause 22" % phy)
    for reg in range(32):
        name = STD.get(reg, "")
        if reg in errs:
            print("  %2d  %-7s ----    err %s" % (reg, name, errs[reg]))
            continue
        if reg not in vals:
            print("  %2d  %-7s ----    (missing)" % (reg, name))
            continue
        v = vals[reg]
        dec = ""
        if reg == 0:
            dec = dec_bmcr(v)
        elif reg == 1:
            dec = dec_bmsr(v)
        elif reg == 3 and 2 in vals:              # compose the 32-bit PHY identifier
            full = (vals[2] << 16) | v
            dec = "id=0x%08x model=0x%02x rev=0x%x" % (full, (v >> 4) & 0x3f, v & 0xf)
        elif reg in (4, 5):
            dec = dec_aneg(v)
        sep = "  " if dec else ""
        print("  %2d  %-7s 0x%04x%s%s" % (reg, name, v, sep, dec))
    return 1 if errs else 0                        # any reg that erred -> non-zero exit


def do_print_mmd(fd, phy, mmd, start, count):
    """Host-side MMD dump: one firmware !read per register."""
    end = start + count
    print("PHY %d - MMD %d registers 0x%04x..0x%04x" % (phy, mmd, start, end - 1))
    rc = 0
    for reg in range(start, end):
        path = path_text(phy, mmd, reg)
        val, err = parse_resp(converse(fd, "!read %s" % path), "read", phy, mmd, reg)
        if err:
            print("  0x%04x  ----    err %s" % (reg, err))
            rc = 1
        else:
            print("  0x%04x  0x%04x" % (reg, val))
    return rc


# ---- verbs -------------------------------------------------------------------
def do_read(fd, phy, mmd, reg):
    path = path_text(phy, mmd, reg)
    val, err = parse_resp(converse(fd, "!read %s" % path), "read", phy, mmd, reg)
    if err:
        sys.stderr.write("mdioctl: read %s: %s\n" % (path, err))
        return 1
    print("0x%04x" % val)                         # phytool: bare value on stdout
    return 0


def do_write(fd, phy, mmd, reg, val, verify=False):
    path = path_text(phy, mmd, reg)
    _, err = parse_resp(converse(fd, "!write %s 0x%04x" % (path, val)),
                        "write", phy, mmd, reg)
    if err:
        sys.stderr.write("mdioctl: write %s: %s\n" % (path, err))
        return 1
    if verify:
        got, err = parse_resp(converse(fd, "!read %s" % path), "read", phy, mmd, reg)
        if err:
            sys.stderr.write("mdioctl: write %s verify: %s\n" % (path, err))
            return 1
        if got != val:
            sys.stderr.write("mdioctl: write %s verify: readback 0x%04x != 0x%04x\n" %
                             (path, got, val))
            return 1
    return 0                                       # phytool: silent on success


def main():
    ap = argparse.ArgumentParser(
        prog="mdioctl", description="phytool-style CLI for the Tapioca MDIO master")
    ap.add_argument("--port", help="CDC port (else $MDIO_PORT, else auto-detect)")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("read", help="read one register: read <phy>/<reg> or <phy>:<mmd>/<reg>")
    p.add_argument("path")
    p = sub.add_parser("write", help="write one register; success is silent")
    p.add_argument("--verify", action="store_true",
                   help="read back and compare after writing; success is still silent")
    p.add_argument("path")
    p.add_argument("val")
    p = sub.add_parser("print", help="pretty-dump registers: print <phy> or print --mmd <mmd> <phy>")
    p.add_argument("--mmd", help="dump one MMD/devad instead of Clause-22 registers")
    p.add_argument("--start", help="first MMD register to dump (default: 0)")
    p.add_argument("--count", help="number of MMD registers to dump (default: 32)")
    p.add_argument("phy")
    args = ap.parse_args()

    # Validate args BEFORE touching hardware, so a bad phy/reg/val reports the real
    # problem (e.g. "phy 32 out of range") instead of "no port found".
    if args.cmd == "read":
        phy, mmd, reg = split_path(args.path, want_reg=True)
    elif args.cmd == "write":
        phy, mmd, reg = split_path(args.path, want_reg=True)
        val = num(args.val, 0, 0xFFFF, "val")
    else:  # print
        phy, _, _ = split_path(args.phy, want_reg=False)
        if args.mmd is None:
            if args.start is not None or args.count is not None:
                sys.exit("mdioctl: --start/--count require --mmd")
            mmd = None
            start = 0
            count = 32
        else:
            mmd = num(args.mmd, 0, 31, "mmd")
            start = num(args.start or "0", 0, 0xFFFF, "start")
            count = num(args.count or "32", 1, 0x10000 - start, "count")

    fd = open_port(pick_port(args.port))
    flush_input(fd)

    if args.cmd == "read":
        rc = do_read(fd, phy, mmd, reg)
    elif args.cmd == "write":
        rc = do_write(fd, phy, mmd, reg, val, verify=args.verify)
    elif mmd is None:  # print
        rc = do_print(fd, phy)
    else:  # print --mmd
        rc = do_print_mmd(fd, phy, mmd, start, count)
    sys.exit(rc)


if __name__ == "__main__":
    main()
